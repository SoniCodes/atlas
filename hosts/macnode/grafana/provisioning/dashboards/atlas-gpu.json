{
  "uid": "atlas-gpu",
  "title": "Atlas — GPU",
  "tags": ["atlas", "gpu"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "VRAM used vs usable ceiling",
      "description": "8192 MiB total minus 352 MiB driver-reserved = 7841 MiB actually allocatable.",
      "gridPos": { "h": 10, "w": 18, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "nvidia_smi_memory_used_bytes{instance=\"atlas\"}",
          "legendFormat": "used"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "nvidia_smi_memory_total_bytes{instance=\"atlas\"} - nvidia_smi_memory_reserved_bytes{instance=\"atlas\"}",
          "legendFormat": "usable ceiling"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "thresholdsStyle": { "mode": "dashed" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 7549747200 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "usable ceiling" },
            "properties": [
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } },
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Headroom now",
      "description": "Allocatable bytes remaining: usable ceiling minus current use.",
      "gridPos": { "h": 10, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "nvidia_smi_memory_total_bytes{instance=\"atlas\"} - nvidia_smi_memory_reserved_bytes{instance=\"atlas\"} - nvidia_smi_memory_used_bytes{instance=\"atlas\"}",
          "legendFormat": "free to allocate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 629145600 },
              { "color": "green", "value": 1610612736 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    }
  ]
}
