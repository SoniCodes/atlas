[Unit]
Description=Grafana
After=network-online.target

[Container]
Image=docker.io/grafana/grafana:13.1.3
ContainerName=grafana
PublishPort=3000:3000
Volume=grafana-data.volume:/var/lib/grafana
Volume=%h/atlas/hosts/macnode/grafana/provisioning:/etc/grafana/provisioning:ro,Z
Secret=grafana-admin-password,type=mount,target=/run/secrets/grafana_admin_password
Environment=GF_SECURITY_ADMIN_PASSWORD__FILE=/run/secrets/grafana_admin_password
Environment=GF_USERS_ALLOW_SIGN_UP=false
Environment=GF_ANALYTICS_REPORTING_ENABLED=false
Environment=GF_ANALYTICS_CHECK_FOR_UPDATES=false

[Service]
Restart=always

[Install]
WantedBy=default.target
