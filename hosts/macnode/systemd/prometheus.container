[Unit]
Description=Prometheus
After=network-online.target

[Container]
Image=docker.io/prom/prometheus:v3.13.2
ContainerName=prometheus
PublishPort=9090:9090
Volume=prom-data.volume:/prometheus
Volume=%h/atlas/hosts/macnode/prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro,Z
Exec=--config.file=/etc/prometheus/prometheus.yml \
     --storage.tsdb.path=/prometheus \
     --storage.tsdb.retention.time=90d \
     --storage.tsdb.retention.size=20GB

[Service]
Restart=always

[Install]
WantedBy=default.target
